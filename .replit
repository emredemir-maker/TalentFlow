modules = ["nodejs-20", "web"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["firebase-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5002
externalPort = 5000

[[ports]]
localPort = 9005
externalPort = 3003

[[ports]]
localPort = 23636
externalPort = 3000

[[ports]]
localPort = 23637
externalPort = 4200

[[ports]]
localPort = 23638
externalPort = 5173

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "node server.js & npx vite preview --port 5000 --host 0.0.0.0"]
build = ["npm", "run", "build"]

[userenv]

[userenv.shared]
# Firebase web yapılandırması burada SABİT DEĞİL: eski projenin değerleri
# kaldırıldı (bkz. docs/yeni-proje-kurulumu.md). Replit kullanılacaksa
# VITE_FIREBASE_* değerlerini Replit Secrets'tan yeni projeye göre girin.

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
