diff --git a/apps/api/src/routes/admin/talent-support.ts b/apps/api/src/routes/admin/talent-support.ts
new file mode 100644
index 0000000..a9b4e75
--- /dev/null
+++ b/apps/api/src/routes/admin/talent-support.ts
@@ -0,0 +1,108 @@
+/**
+ * Yönetim konsolu → Talent destek erişimi (TalentFlow docs/coklu-sirket-plani.md K11). index.ts'te requireAdmin'in
+ * arkasında (admin kapsamlı oturum, PLATFORM_ADMIN_EMAILS, ADMIN_ORIGINS + x-clyro-admin, admin IdP kiracısı + TOTP).
+ *
+ * Platform yöneticisi bir şirketin Talent verisini üye olmadan göremez. Destek gerektiğinde konsoldan gerekçe yazılarak
+ * istenir; Hub, Talent'a imzalı istek gönderir (services/talent-m2m.ts) ve Talent o şirkette süreli (en çok 24 saat),
+ * salt okunur bir `support` üyeliği açar; süre dolunca kurallar erişimi kendiliğinden kapatır. Açma kritik işlemdir
+ * (requireFreshAuth); açma ve kapatma Hub işlem kaydına (`source = 'admin'`) ve Talent'ta şirketin kendi denetim
+ * defterine gerekçeyle düşer — şirket yöneticisi kendi defterinde görür.
+ *
+ * Destek kimliği konsol hesabı DEĞİL: konsol hesabı ayrı Identity Platform kiracısında ve Talent'a giremez. Yöneticinin
+ * aynı e-postalı Hub hesabının Firebase kimliği kullanılır; Hub hesabı yoksa 409 (önce Hub'a bir kez girilmeli). Destek
+ * verilen şirket kişinin Talent şirket seçicisinde görünür; Talent'a kendi Hub alanından girer.
+ */
+import { Router, type Request, type Response } from "express";
+import { and, eq, isNotNull } from "drizzle-orm";
+import { z } from "zod";
+import { tenants, users, type Db } from "@hub-inn/db";
+import { HttpError, parseBody } from "../../http";
+import { requireFreshAuth } from "../../middleware/admin";
+import { audit } from "../../services/audit";
+import type { TalentM2mClient } from "../../services/talent-m2m";
+
+const grantBody = z.strictObject({
+  reason: z.string().trim().min(10, "Gerekçe en az 10 karakter").max(500, "Gerekçe en çok 500 karakter"),
+  ttlHours: z.number().int().min(1).max(24).default(24),
+});
+
+const SUPPORT_PATH = "/api/hub/support-access";
+
+export function adminTalentSupportRoutes(deps: { db: Db; talent: TalentM2mClient | null }) {
+  const { db } = deps;
+  const r = Router();
+
+  const tenantIdOf = (v: unknown) => {
+    const p = z.string().uuid().safeParse(v);
+    if (!p.success) throw new HttpError(404, "Çalışma alanı bulunamadı");
+    return p.data.toLowerCase();
+  };
+
+  /** Ortak hazırlık: Talent bağlı mı, alan var mı, yöneticinin Hub kimliği. */
+  async function prepare(req: Request) {
+    if (!deps.talent) throw new HttpError(503, "Talent bağlantısı yapılandırılmamış (TALENT_EVENTS_SECRET)");
+    const tenantId = tenantIdOf(req.params.id);
+    const [t] = await db.select({ id: tenants.id, name: tenants.name }).from(tenants).where(eq(tenants.id, tenantId)).limit(1);
+    if (!t) throw new HttpError(404, "Çalışma alanı bulunamadı");
+    const admin = req.adminAuth!.user;
+    const [u] = await db
+      .select({ firebaseUid: users.firebaseUid, email: users.email })
+      .from(users)
+      .where(and(eq(users.email, admin.email), isNotNull(users.firebaseUid)))
+      .limit(1);
+    if (!u?.firebaseUid) {
+      throw new HttpError(409, "Destek erişimi Hub hesabınıza açılır: önce aynı e-postayla Clyro Hub'a bir kez giriş yapın.");
+    }
+    return { tenantId, admin, firebaseUid: u.firebaseUid, email: u.email };
+  }
+
+  async function send(res: Response, body: Record<string, unknown>) {
+    try {
+      return await deps.talent!.post(SUPPORT_PATH, body);
+    } catch {
+      res.status(502).json({ error: "Talent'a ulaşılamadı" });
+      return null;
+    }
+  }
+
+  r.post("/tenants/:id/talent-support", requireFreshAuth, async (req, res) => {
+    const body = parseBody(grantBody, req);
+    const p = await prepare(req);
+    const out = await send(res, {
+      type: "support.grant",
+      tenantId: p.tenantId,
+      uid: p.firebaseUid,
+      email: p.email,
+      reason: body.reason,
+      requestedBy: p.admin.email,
+      ttlHours: body.ttlHours,
+    });
+    if (!out) return;
+    if (out.status === 404) throw new HttpError(409, "Bu çalışma alanı Talent'ı henüz hiç açmamış");
+    if (out.status === 409) throw new HttpError(409, "Bu kişi zaten şirketin Talent üyesi; destek erişimine gerek yok");
+    if (out.status !== 200) throw new HttpError(502, "Talent isteği reddetti");
+    const expiresAt = new Date(Date.now() + body.ttlHours * 3_600_000);
+    await audit(db, {
+      tenantId: p.tenantId,
+      actorUserId: p.admin.id,
+      action: "talent.support_granted",
+      targetType: "app",
+      targetId: "talent",
+      metadata: { reason: body.reason, ttlHours: body.ttlHours, expiresAt: expiresAt.toISOString() },
+      source: "admin",
+    });
+    res.json({ ok: true, expiresAt });
+  });
+
+  // Kapatma erişimi daraltır: taze kimlik istenmez (süresinden önce kapatmak hızlı olmalı).
+  r.delete("/tenants/:id/talent-support", async (req, res) => {
+    const p = await prepare(req);
+    const out = await send(res, { type: "support.revoke", tenantId: p.tenantId, uid: p.firebaseUid, requestedBy: p.admin.email });
+    if (!out) return;
+    if (out.status !== 200) throw new HttpError(502, "Talent isteği reddetti");
+    await audit(db, { tenantId: p.tenantId, actorUserId: p.admin.id, action: "talent.support_revoked", targetType: "app", targetId: "talent", source: "admin" });
+    res.json({ ok: true });
+  });
+
+  return r;
+}
