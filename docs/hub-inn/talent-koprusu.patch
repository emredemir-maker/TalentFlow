@@ -0,0 +1,223 @@
+/**
+ * Talent köprüsü (TalentFlow çok şirketli PR 4): Talent'ın sunucudan sunucuya kod değişimi (plan + deneme bitişi + ret
+ * gerekçesi) ve yönetim konsolundan Talent destek erişimi (K11: gerekçe, en çok 24 saat, taze kimlik, imzalı istek,
+ * `source = 'admin'` işlem kaydı).
+ */
+import { test, before, after, describe } from "node:test";
+import assert from "node:assert/strict";
+import { createHash, createHmac } from "node:crypto";
+import { and, eq } from "drizzle-orm";
+import { auditLogs, sessions, tenants, users } from "@hub-inn/db";
+import { createTalentM2mClient } from "./services/talent-m2m";
+import {
+  adminConsole,
+  ADMIN_EMAIL,
+  startTestApp,
+  tenantWithAdmin,
+  TEST_APP_LINKS,
+  TEST_CX_EXCHANGE_SECRET,
+  TEST_MEET_EXCHANGE_SECRET,
+  type Client,
+  type TestApp,
+} from "./test-support";
+
+const TALENT_EXCHANGE = "test-talent-exchange-secret-0123456789abcdef";
+const TALENT_EVENTS = "test-talent-events-secret-0123456789abcdefgh";
+
+interface Sent {
+  url: string;
+  headers: Record<string, string>;
+  body: string;
+}
+const sent: Sent[] = [];
+let talentReply: { status: number; body: unknown } = { status: 200, body: { ok: true } };
+const fakeFetch = (async (url: string, init: RequestInit) => {
+  sent.push({ url, headers: init.headers as Record<string, string>, body: String(init.body) });
+  return new Response(JSON.stringify(talentReply.body), { status: talentReply.status, headers: { "content-type": "application/json" } });
+}) as unknown as typeof fetch;
+
+let t: TestApp;
+before(async () => {
+  t = await startTestApp({
+    appExchangeSecrets: new Map([
+      ["cx", TEST_CX_EXCHANGE_SECRET],
+      ["meet", TEST_MEET_EXCHANGE_SECRET],
+      ["talent", TALENT_EXCHANGE],
+    ]),
+    talentM2m: createTalentM2mClient({ baseUrl: "https://talent.example.test", secret: TALENT_EVENTS, fetch: fakeFetch }),
+  });
+});
+after(() => t.close());
+
+const codeOf = (url: string) => url.split("#code=")[1]!;
+async function launch(c: Client, app = "talent") {
+  const r = await c.call("POST", `/api/apps/${app}/launch`);
+  assert.equal(r.status, 200, JSON.stringify(r.body));
+  return codeOf(r.body.url as string);
+}
+async function serverExchange(code: string, secret = TALENT_EXCHANGE) {
+  const res = await fetch(`${t.base}/api/apps/server-exchange`, {
+    method: "POST",
+    headers: { "content-type": "application/json", authorization: `Bearer ${secret}` },
+    body: JSON.stringify({ app: "talent", code }),
+  });
+  return { status: res.status, body: (await res.json().catch(() => null)) as any };
+}
+
+describe("Talent sunucu yolu", () => {
+  test("jeton + alan + rol + plan döner; denemedeki alanda deneme bitişi", async () => {
+    const { tenantId, admin } = await tenantWithAdmin(t, "talent-kopru", "yonetici@talent-kopru.test");
+    const r = await serverExchange(await launch(admin));
+    assert.equal(r.status, 200);
+    assert.equal(r.body.token, "launch-token|uid-yonetici@talent-kopru.test");
