diff --git a/apps/api/src/services/talent-m2m.ts b/apps/api/src/services/talent-m2m.ts
new file mode 100644
index 0000000..5c2b6ce
--- /dev/null
+++ b/apps/api/src/services/talent-m2m.ts
@@ -0,0 +1,57 @@
+/**
+ * Hub API → Clyro Talent sunucudan sunucuya (M2M) istemcisi. Kimlik yalnız CLYRO-M2M-V1 HMAC imzasıdır (services/cx-m2m.ts
+ * ile aynı imza metni); gönderen satırı `hub`. Talent tarafı: TalentFlow functions/services/hubBridge.js → verifyHubSignature
+ * (±120 sn, tek kullanımlık nonce). Gizli değer (`TALENT_EVENTS_SECRET`, Talent'ta `HUB_EVENTS_SECRET`) kabloda gitmez,
+ * günlüğe yazılmaz. Origin başlığı gönderilmez (Talent tarayıcı isteğini reddeder); yönlendirme izlenmez.
+ */
+import { randomBytes } from "node:crypto";
+import { M2M_HEADERS, m2mSign, sha256Hex } from "./cx-m2m";
+
+export const TALENT_M2M_ACTOR = "hub";
+
+export interface TalentResponse {
+  status: number;
+  json: unknown;
+}
+
+export interface TalentM2mClient {
+  /** Yol /api/hub/ ile başlar. Ağ hatası/zaman aşımında Error atar. */
+  post(path: string, body: unknown): Promise<TalentResponse>;
+}
+
+export function createTalentM2mClient(opts: { baseUrl: string; secret: string; fetch?: typeof fetch; now?: () => number; timeoutMs?: number }): TalentM2mClient {
+  const base = opts.baseUrl.replace(/\/+$/, "");
+  const doFetch = opts.fetch ?? fetch;
+  const now = opts.now ?? Date.now;
+  return {
+    async post(path, body) {
+      if (!path.startsWith("/api/hub/")) throw new Error("Talent M2M yolu /api/hub/ ile başlamalı");
+      // Ham gövdenin tamamı imzalanır; gönderilen baytlar imzalananlarla aynı.
+      const payload = JSON.stringify(body);
+      const timestamp = String(Math.floor(now() / 1000));
+      const nonce = randomBytes(18).toString("base64url");
+      const res = await doFetch(base + path, {
+        method: "POST",
+        headers: {
+          [M2M_HEADERS.timestamp]: timestamp,
+          [M2M_HEADERS.nonce]: nonce,
+          [M2M_HEADERS.actor]: TALENT_M2M_ACTOR,
+          [M2M_HEADERS.signature]: m2mSign(opts.secret, { method: "POST", path, timestamp, nonce, actor: TALENT_M2M_ACTOR, bodySha256: sha256Hex(payload) }),
+          "content-type": "application/json",
+          accept: "application/json",
+        },
+        body: payload,
+        redirect: "manual",
+        signal: AbortSignal.timeout(opts.timeoutMs ?? 10_000),
+      });
+      const text = await res.text();
+      let json: unknown = null;
+      try {
+        json = text ? JSON.parse(text) : null;
+      } catch {
+        // ağ geçidi sayfası
+      }
+      return { status: res.status, json };
+    },
+  };
+}
