+
+/**
+ * Talent destek erişimi (K11): platform yöneticisi şirketin Talent verisini üye olmadan göremez. Gerekçe yazılarak süreli
+ * (en çok 24 saat), salt okunur destek üyeliği istenir; Talent'ta şirketin kendi denetim defterine ve buradaki işlem
+ * kaydına düşer, süre dolunca kendiliğinden kapanır. Kritik işlem: taze kimlik ister.
+ */
+function TalentSupport({ tenantId, onDone }: { tenantId: string; onDone: () => void }) {
+  const critical = useCritical();
+  const [reason, setReason] = useState("");
+  const [hours, setHours] = useState(24);
+  const grant = useMutation({
+    mutationFn: () => critical(() => api<{ expiresAt: string }>("POST", `/tenants/${tenantId}/talent-support`, { reason: reason.trim(), ttlHours: hours })),
+    onSuccess: () => {
+      setReason("");
+      onDone();
+    },
+  });
+  const revoke = useMutation({ mutationFn: () => api("DELETE", `/tenants/${tenantId}/talent-support`), onSuccess: onDone });
+  const submit = (e: FormEvent) => {
+    e.preventDefault();
+    grant.mutate();
+  };
+  return (
+    <Panel title="Talent destek erişimi" className="mt-4">
+      <p className="border-b border-ink-100 px-4 py-2 text-xs text-ink-500">
+        Şirketin Talent verisini yalnız süreli ve salt okunur görürsünüz. Gerekçe şirketin kendi denetim defterinde görünür.
+        Erişim Hub hesabınıza açılır: Talent'ı kendi Hub alanınızdan açıp şirket seçiciden bu şirketi seçin.
+      </p>
+      <form className="space-y-3 p-4" onSubmit={submit}>
+        <Field label="Gerekçe" hint="En az 10 karakter (ör. destek talebi numarası ve sorun)">
+          <Input required minLength={10} maxLength={500} value={reason} onChange={(e) => setReason(e.target.value)} />
+        </Field>
+        <div className="flex flex-wrap items-end gap-2">
+          <Field label="Süre (saat)">
+            <Input type="number" min={1} max={24} value={hours} onChange={(e) => setHours(Math.min(24, Math.max(1, Number(e.target.value) || 1)))} />
+          </Field>
+          <Button type="submit" disabled={grant.isPending || reason.trim().length < 10}>Destek erişimi iste</Button>
+          <Button type="button" variant="ghost" disabled={revoke.isPending} onClick={() => { if (confirm("Destek erişimi şimdi kapatılsın mı?")) revoke.mutate(); }}>Erişimi kapat</Button>
+        </div>
+        {grant.data && <p className="text-xs text-ink-500">Açıldı; {dateTime(grant.data.expiresAt)} tarihinde kendiliğinden kapanır.</p>}
+        {revoke.isSuccess && <p className="text-xs text-ink-500">Destek erişimi kapatıldı.</p>}
+        <ErrorText>{grant.error?.message ?? revoke.error?.message}</ErrorText>
+      </form>
+    </Panel>
+  );
+}
