# Firebase Functions production environment variables
# Firebase Functions yalnızca `functions/.env` (ve .env.<proje-id>) dosyasını
# yükler; CI bu dosyayı GitHub secret'larından yazar
# (.github/workflows/firebase-deploy.yml). Elle dağıtımda bu şablonu
# functions/.env olarak kopyalayın. Gerçek değerleri commit ETMEYİN.

EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password
GEMINI_API_KEY=your-gemini-api-key
# Kullanıcıların Gmail/Calendar ve Microsoft OAuth jetonlarını şifreleyen
# AES-256-GCM anahtarı (base64, 32 bayt). Üretimde ZORUNLU — yoksa sunucu açılmaz.
# Üretmek: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DEĞİŞTİRMEYİN: değişirse kayıtlı bağlantılar çözülemez, herkes yeniden bağlanır.
INTEGRATION_ENCRYPTION_KEY=base64-32-byte-key
VITE_FIREBASE_API_KEY=your-firebase-api-key

# Optional overrides — normally NOT needed in production:
# The Storage bucket for CV uploads is auto-detected from the runtime's
# FIREBASE_CONFIG. Set this only to target a non-default bucket.
# FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# Base URL for locally-served CV links when running the backend as a plain
# node server (not Cloud Functions), e.g. Replit. Unused on Cloud Functions:
# there a failed Storage upload yields an empty cvUrl instead of a dead link.
# SERVER_URL=https://your-app.example.com

# ── Clyro Hub köprüsü (functions/routes/hub.js, PR 4) ──
# Hub API kökü (sır değil), https ve sonda /api.
# HUB_API_URL=https://<hub-alan-adı>/api
# Hub'daki APP_EXCHANGE_SECRETS içindeki `talent=` değeriyle AYNI (en az 32 karakter).
# HUB_EXCHANGE_SECRET=
# Hub → Talent imzalı olaylar (CLYRO-M2M-V1); Hub'daki TALENT_EVENTS_SECRET ile AYNI,
# HUB_EXCHANGE_SECRET'tan FARKLI (aynıysa olay ucu kapalı kalır).
# HUB_EVENTS_SECRET=
# Hub doğrulamasının geçerlik süresi (saat, 1–24; varsayılan ve üst sınır 24).
# HUB_VERIFY_MAX_AGE_HOURS=24
