rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── Kimlik yardımcıları ───────────────────────────────────────────────────
    //
    // ANONİM OTURUM İÇ KULLANICI DEĞİLDİR. Uygulama aday tarafındaki herkese
    // açık sayfalarda (/apply/, /live-interview/, /join/) otomatik olarak
    // anonim oturum açıyor. Yani `request.auth != null` demek "personelden
    // biri" değil, "başvuru sayfasını açmış herhangi biri" demek.
    //
    // Kayıt davet ya da izinli alan adı gerektirdiği için anonim olmayan her
    // oturum iç kullanıcıya aittir.
    function isStrictAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // ── CV dosyaları ──────────────────────────────────────────────────────────
    //
    // ── BURADA NE VARDI ─────────────────────────────────────────────────────
    // `allow read: if request.auth != null` yazıyordu ve bu iki ayrı kapıyı
    // birden açıyordu:
    //
    //   1. ANONİM ERİŞİM — başvuru sayfasını açan herkes anonim token alıyor.
    //      Aday olarak giren biri iç havuzdaki CV'lere erişebiliyordu.
    //   2. LİSTELEME — Storage'da da `read` hem `get` hem `list` demek.
    //      Yani klasörün tamamı dökülüp bütün CV'ler indirilebiliyordu.
    //
    // İkisi birlikte, ürünün en hassas verisini (ad, telefon, adres, tüm iş
    // geçmişi) herkese açık hale getiriyordu. Aynı tuzağı firestore.rules'ta
    // da bulmuştuk; orada kapatıldı, burada kalmış.
    //
    // ── ŞİMDİ ───────────────────────────────────────────────────────────────
    // get   : yalnızca anonim OLMAYAN oturum (iç kullanıcı)
    // list  : kapalı — uygulama hiçbir yerde klasör listelemiyor, dosyalara
    //         kayıtta saklanan indirme adresiyle ulaşılıyor
    // write : yalnızca iç kullanıcı. Başvuru formu Storage'a dosya YAZMIYOR;
    //         CV metnini tarayıcıda çıkarıp gönderiyor, dolayısıyla anonim
    //         yazma yetkisinin bir karşılığı yok.
    match /cvs/{filename} {
      allow get:   if isStrictAuth();
      allow list:  if false;
      allow write: if isStrictAuth()
                      && request.resource.size < 20 * 1024 * 1024;
    }

    // Alt klasörler (ileride kullanılırsa) — aynı kural.
    match /cvs/{candidateId}/{allPaths=**} {
      allow get:   if isStrictAuth();
      allow list:  if false;
      allow write: if isStrictAuth()
                      && request.resource.size < 20 * 1024 * 1024;
    }

    // ── Toplu içe aktarma kaynakları ─────────────────────────────────────────
    // Tarayıcı ZIP/PDF/DOCX'i buraya yükler, API'ye yalnızca YOL gönderilir.
    // Bu yol Hosting rewrite'ından geçmediği için ne 32MB gövde sınırı ne de
    // 60 saniyelik kesme uygulanır (gerekçe: functions/services/bulkSources.js).
    //
    // Yolun içinde uid taşınması kasıtlı: yazma iznini burada, okuma/silme
    // yetkisini sunucuda AYNI tek gerçek belirler (parseSources). Kullanıcı
    // yalnızca kendi klasörüne yazar; sunucu da yolun kendisine ait olduğunu
    // doğrulamadan hiçbir dosyayı açmaz.
    //
    // Okuma yok: dosyayı yalnızca Admin SDK (kuralları atlar) indirir. İçeride
    // başkasının CV'si var, tarayıcıya açmanın bir sebebi yok.
    match /bulk-imports/{userId}/{allPaths=**} {
      allow read:   if false;
      // isStrictAuth: anonim oturumun da bir uid'i var, dolayısıyla eski kural
      // aday tarafındaki bir ziyaretçinin kendi klasörüne 200MB'a kadar dosya
      // yüklemesine izin veriyordu. Okuma kapalı olduğu için veri sızıntısı
      // değil ama depolama maliyeti üretmeye açık bir kapıydı.
      allow write:  if isStrictAuth()
                       && request.auth.uid == userId
                       && request.resource.size < 200 * 1024 * 1024;
    }

    // Whitelist of safe raster image MIME types. Excludes image/svg+xml,
    // which can carry inline JS and is therefore an XSS vector when the
    // asset is later rendered as <img> on a same-origin domain.
    function isSafeImageType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/gif'
      ];
    }

    // ── Branding assets ───────────────────────────────────────────────────────
    // BrandingSettingsPage uploads to: branding/logo_{timestamp}_{filename}
    // Write: super_admin only (Custom Claim role OR Firestore role).
    // Read:  any authenticated user.
    // Okuma anonime de açık: başvuru ve giriş sayfaları logoyu oturum
    // açılmadan gösteriyor. Listeleme yine de kapalı — dosya adlarını dökmenin
    // hiçbir meşru kullanımı yok.
    match /branding/{filename} {
      allow get:   if request.auth != null;
      allow list:  if false;
      allow write: if request.auth != null
                      && request.auth.token.role == 'super_admin'
                      && request.resource.size < 10 * 1024 * 1024
                      && isSafeImageType();
    }

    // ── Profile / avatar images ───────────────────────────────────────────────
    // Write: only the owner of the avatar slot
    match /avatars/{userId}/{allPaths=**} {
      allow get:   if isStrictAuth();
      allow list:  if false;
      allow write: if isStrictAuth()
                      && request.auth.uid == userId
                      && request.resource.size < 5 * 1024 * 1024
                      && isSafeImageType();
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
