rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Clyro Talent — çok şirketli Storage kuralları.
// Tasarım: docs/coklu-sirket-plani.md §3.2. Testler: tests/rules/storage.test.js.
//
// Dosyalar `tenants/{tenantId}/…` altında; yetki Firestore'daki üyelik
// belgesinden (tenants/{t}/members/{uid}) çapraz okumayla gelir. Jetondaki
// `role` talebine bakılmaz (Auth Hub/CX ile ortak).
//
// İlk dağıtımda Firebase CLI, Storage hizmet hesabına Firestore okuma rolü
// verilmesini ister (çapraz kural için; paylaşılan projede Emre onayıyla, tek
// seferlik).
//
// Not: kayıttaki `getDownloadURL` jetonlu adresleri kuralları ATLAR; ayrım yalnız
// adresi bilmeyenler için geçerli. Kural denetimli indirme PR 6'da.
// ─────────────────────────────────────────────────────────────────────────────
service firebase.storage {
  match /b/{bucket}/o {

    // Anonim oturum aday sayfalarına ait; iç kullanıcı değildir.
    function isStrictAuth() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Üyelik belgesi — tek firestore.get (belge yoksa null).
    function membership(t) {
      return firestore.get(/databases/(default)/documents/tenants/$(t)/members/$(request.auth.uid));
    }

    // Etkin üye ve rolü listede. Destek üyeliği (K11) süreli.
    function hasRole(t, roles) {
      let m = membership(t);
      return isStrictAuth()
        && m != null
        && m.data.get('status', '') == 'active'
        && (m.data.get('expiresAt', null) == null || request.time < m.data.expiresAt)
        && m.data.get('role', '') in roles;
    }

    function allRoles() {
      return ['admin', 'recruiter', 'department_user', 'support'];
    }

    // SVG satır içi betik taşıyabilir; yalnız raster resimler.
    function isSafeImageType() {
      return request.resource.contentType in [
        'image/jpeg',
        'image/png',
        'image/webp',
        'image/gif'
      ];
    }

    // ── CV dosyaları ──────────────────────────────────────────────────────────
    // get: şirketin etkin üyesi. list: kapalı (uygulama klasör listelemiyor).
    // write: admin/recruiter, 20MB. Silme sunucuda (Admin SDK).
    match /tenants/{tenantId}/cvs/{allPaths=**} {
      allow get:   if hasRole(tenantId, allRoles());
      allow list:  if false;
      allow write: if hasRole(tenantId, ['admin', 'recruiter'])
                      && request.resource.size < 20 * 1024 * 1024;
    }

    // ── Toplu içe aktarma kaynakları ─────────────────────────────────────────
    // Kişi yalnız kendi klasörüne yazar; dosyayı yalnız sunucu açar
    // (functions/services/bulkSources.js önek denetimi). Okuma kapalı.
    match /tenants/{tenantId}/bulk-imports/{userId}/{allPaths=**} {
      allow read:  if false;
      allow write: if request.auth != null
                      && request.auth.uid == userId
                      && hasRole(tenantId, ['admin', 'recruiter', 'department_user'])
                      && request.resource.size < 200 * 1024 * 1024;
    }

    // ── Şirket logosu ───────────────────────────────────────────────────────
    // Başvuru sayfası (anonim oturum) da gösterir → her oturum okur.
    match /tenants/{tenantId}/branding/{filename} {
      allow get:   if request.auth != null;
      allow list:  if false;
      allow write: if hasRole(tenantId, ['admin'])
                      && request.resource.size < 10 * 1024 * 1024
                      && isSafeImageType();
    }

    // ── Profil resmi — kişiye ait, şirketler arası ortak ────────────────────
    match /avatars/{userId}/{allPaths=**} {
      allow get:   if isStrictAuth();
      allow list:  if false;
      allow write: if isStrictAuth()
                      && request.auth.uid == userId
                      && request.resource.size < 5 * 1024 * 1024
                      && isSafeImageType();
    }

    // ── Eski ortak yollar — KAPALI (K10) ─────────────────────────────────────
    // cvs/**, branding/**, bulk-imports/** veri taşınmadan silinecek (PR 8).
    match /cvs/{allPaths=**} {
      allow read, write: if false;
    }
    match /branding/{allPaths=**} {
      allow read, write: if false;
    }
    match /bulk-imports/{allPaths=**} {
      allow read, write: if false;
    }

    // ── Varsayılan red ──────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
