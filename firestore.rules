rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ──────────────────────────────────────────────────────────
    // Strict: excludes anonymous sessions
    function isStrictAuthenticated() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Loose: includes anonymous candidates on public routes
    function isAuthenticatedIncAnon() {
      return request.auth != null;
    }

    // Check if the caller's user document exists in Firestore
    function userDocExists() {
      return exists(/databases/$(database)/documents/artifacts/talent-flow/public/data/users/$(request.auth.uid));
    }

    // Read the caller's user profile (cached per request by Firestore)
    function getUserProfile() {
      return get(/databases/$(database)/documents/artifacts/talent-flow/public/data/users/$(request.auth.uid)).data;
    }

    // ── Role helpers ──────────────────────────────────────────────────────────
    // Two independent break-glass paths: Custom Claim (Firebase Auth token)
    // OR Firestore user doc role. Either alone grants super_admin, so a bug
    // in one path doesn't lock out admins. Run scripts/grant-super-admin.mjs
    // to set BOTH paths atomically.
    function isSuperAdmin() {
      return isStrictAuthenticated() &&
        (request.auth.token.role == 'super_admin' ||
         (userDocExists() && getUserProfile().role == 'super_admin'));
    }

    function isRecruiter() {
      return isStrictAuthenticated() &&
        (isSuperAdmin() ||
         request.auth.token.role == 'recruiter' ||
         (userDocExists() && getUserProfile().role == 'recruiter'));
    }

    function isDepartmentUser() {
      return isStrictAuthenticated() &&
        userDocExists() &&
        getUserProfile().role == 'department_user';
    }

    // Department-scoped candidate access check (document-level read)
    function canAccessCandidate(candidateData) {
      return isRecruiter() ||
        (isDepartmentUser() &&
         candidateData.department != null &&
         'departments' in getUserProfile() &&
         getUserProfile().departments != null &&
         candidateData.department in getUserProfile().departments);
    }

    // ── Registration validation ───────────────────────────────────────────────
    // Self-registration may only mint non-admin roles, and the requested role
    // must be backed by evidence the rules can verify: a pending invitation
    // (the client stores its doc ID in the profile's `inviteId` field) or the
    // allow-listed e-mail domain (recruiter only). super_admin is never
    // creatable from the client — bootstrap via scripts/grant-super-admin.mjs.
    function callerEmail() {
      return request.auth.token.email.lower();
    }

    function isEmailDomainAllowed() {
      return get(/databases/$(database)/documents/artifacts/talent-flow/public/data/settings/system)
        .data.get('allowedDomains', [])
        .hasAny([callerEmail().split('@')[1]]);
    }

    function hasValidInvite() {
      return request.resource.data.get('inviteId', '') is string &&
        request.resource.data.get('inviteId', '') != '' &&
        inviteMatchesRequest(request.resource.data.inviteId);
    }

    function inviteMatchesRequest(inviteId) {
      let inv = get(/databases/$(database)/documents/artifacts/talent-flow/public/data/invitations/$(inviteId)).data;
      return inv.get('status', '') == 'pending' &&
        inv.get('email', '') == callerEmail() &&
        request.resource.data.role == inv.get('role', 'recruiter') &&
        (request.resource.data.role != 'department_user' ||
         request.resource.data.get('departments', []) == inviteDepartments(inv));
    }

    // Invitation department list, tolerating the legacy single `department`
    // field (mirrors the fallback chain in AuthContext).
    function inviteDepartments(inv) {
      return inv.get('departments',
        inv.get('department', null) != null ? [inv.department] : []);
    }

    // ── Invitations ───────────────────────────────────────────────────────────
    // KAPALI. Burada `allow read: if true` vardı çünkü kayıt akışı, hesap
    // henüz yokken e-postaya göre davet arıyordu. Ama Firestore'da `read`
    // hem `get` hem `list` demek: kural, kimliksiz bir istemcinin davet
    // edilmiş BÜTÜN e-postaları ve rollerini tek istekte okumasına izin
    // veriyordu.
    //
    // Sorgu sunucuya taşındı (POST /api/auth/invitation-lookup, Admin SDK ile
    // kuralların dışında çalışır ve yalnızca inviteId/role/departments döner),
    // dolayısıyla istemcinin bu koleksiyona hiç erişmesi gerekmiyor.
    //
    // NOT: Kullanıcı dokümanı yazılırken `inviteMatchesRequest` bu koleksiyonu
    // okuyor — kural içindeki `get()` çağrıları bu kısıttan etkilenmez.
    match /artifacts/talent-flow/public/data/invitations/{inviteId} {
      allow read:  if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ── Positions (public job board) ──────────────────────────────────────────
    // Anyone can read (job applicants). Recruiters can write.
    match /artifacts/talent-flow/public/data/positions/{positionId} {
      allow read:  if true;
      allow write: if isRecruiter();
    }

    // ── Applications (public submission) ─────────────────────────────────────
    // Anyone can submit. Only recruiters can read/manage.
    match /artifacts/talent-flow/public/data/applications/{applicationId} {
      allow create:              if true;
      allow read, update, delete: if isRecruiter();
    }

    // ── Candidates ────────────────────────────────────────────────────────────
    // • create: anonymous candidates submitting public forms
    // • get:    document-level read —
    //     - Anonymous users (live interview candidates): can read any candidate
    //       document by ID. The session ID (128-bit UUID capability token) is
    //       the access gate; without the link they can't know the candidate ID.
    //     - Authenticated recruiter: sees all candidates
    //     - Authenticated dept_user: only candidates in their departments array
    // • list:   query-level — recruiter or dept_user (client code sends a
    //           .where('department', 'in', [...]) filter for dept_users)
    // • update/delete: recruiter or super_admin only
    match /artifacts/talent-flow/public/data/candidates/{candidateId} {
      allow create:        if isAuthenticatedIncAnon();
      allow get:           if (isAuthenticatedIncAnon() &&
                                request.auth.token.firebase.sign_in_provider == 'anonymous') ||
                              canAccessCandidate(resource.data);
      allow list:          if isRecruiter() || isDepartmentUser();
      allow update, delete: if isRecruiter();
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // • read:   self, or any recruiter/super_admin (needed for user-management UI)
    //           department_users can only read their own profile
    // • create: only the caller's own doc (uid match, non-anonymous), with a
    //           non-admin role justified by a pending invitation or the
    //           allow-listed e-mail domain — see Registration validation above
    // • update: super_admin (any field) · self (own profile, but never the
    //           privilege/identity fields) · recruiter (department assignment
    //           only, used by the department management page)
    // • delete: super_admin only
    match /artifacts/talent-flow/public/data/users/{userId} {
      allow read:   if isSuperAdmin() ||
                       isRecruiter()  ||
                       (isStrictAuthenticated() && request.auth.uid == userId);
      allow create: if isStrictAuthenticated() &&
                       request.auth.uid == userId &&
                       request.resource.data.get('uid', userId) == userId &&
                       request.resource.data.get('role', '') in ['recruiter', 'department_user'] &&
                       request.resource.data.get('email', '') == callerEmail() &&
                       (hasValidInvite() ||
                        (request.resource.data.role == 'recruiter' && isEmailDomainAllowed()));
      allow update: if isSuperAdmin() ||
                       (isStrictAuthenticated() && request.auth.uid == userId &&
                        !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['role', 'status', 'department', 'departments', 'email', 'uid'])) ||
                       (isRecruiter() &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['department', 'departments']));
      allow delete: if isSuperAdmin();

      match /{allChildren=**} {
        allow read, write: if isStrictAuthenticated() &&
                              (request.auth.uid == userId || isSuperAdmin());
      }
    }

    // ── Departments ───────────────────────────────────────────────────────────
    // Read: any authenticated user (org chart visibility)
    // Write: super_admin only (structure changes are sensitive)
    match /artifacts/talent-flow/public/data/departments/{deptId} {
      allow read:  if isStrictAuthenticated();
      allow write: if isSuperAdmin();
    }

    // ── Sources (candidate origin tracking) ──────────────────────────────────
    // Anonymous users (candidates on the apply form) need to read sources for
    // the "where did you find us?" dropdown.
    match /artifacts/talent-flow/public/data/sources/{sourceId} {
      allow read:  if isAuthenticatedIncAnon();
      allow write: if isRecruiter();
    }

    // ── Şirket istihbaratı önbelleği ─────────────────────────────────────────
    // Aday CV'lerinde geçen şirketlerin çözümlenmiş kaydı (services/
    // companyIntelStore.js). Havuzdaki şirketler çok tekrar ettiği için
    // önbellek ADAYIN değil ŞİRKETİN altında duruyor ve tüm ekibe hizmet eder.
    //
    // KİŞİSEL VERİ TAŞIR: kurucu/ortak adları. Bu adlar ticaret sicilinden,
    // yani zaten yayımlanmış kayıttan geliyor — ama yine de kişisel veri.
    // Bu yüzden okuma da yazma da RECRUITER ile sınırlı; department_user
    // göremez. list kapalı: koleksiyonun tamamını dökmek, havuzdaki tüm
    // şirketlerin kurucu adlarını tek istekte vermek olurdu.
    match /artifacts/talent-flow/public/data/companyIntel/{companyId} {
      allow get:   if isRecruiter();
      allow list:  if false;
      allow write: if isRecruiter();
    }

    // ── Settings ─────────────────────────────────────────────────────────────
    // api_keys ve integrations dokümanları SIR taşır (Gemini anahtarı, OAuth
    // clientSecret) — client hiçbir rolde okuyamaz/yazamaz; sunucu Admin SDK
    // ile /api/admin/* üzerinden yönetir.
    // system ve branding sır içermez ve profil oluşmadan ÖNCE okunur
    // (AuthContext kayıt akışı allowedDomains'i, sayfalar logoyu okur) —
    // bu yüzden strict-auth yeterlidir.
    // list DAİMA kapalı: koleksiyon sorgusu doküman bazlı istisnaları
    // kanıtlayamayacağı için tüm listeler reddedilir; sayfalar tekil get yapar.
    function isSecretSetting(settingId) {
      return settingId == 'api_keys' || settingId == 'integrations';
    }
    match /artifacts/talent-flow/public/data/settings/{settingId} {
      allow get:   if !isSecretSetting(settingId) &&
                      ((settingId == 'system' || settingId == 'branding')
                        ? isStrictAuthenticated()
                        : isRecruiter());
      allow list:  if false;
      allow write: if !isSecretSetting(settingId) && isSuperAdmin();
    }

    // ── Info Requests (candidate respond link) ────────────────────────────────
    // requestId is an unguessable random ID — acts as a capability token.
    // Candidates need public read so they can view the request and respond.
    //
    // GET AÇIK, LIST KAPALI. Yetki anahtarı olan şey KİMLİĞİN KENDİSİ: linki
    // olmayan kayda ulaşamaz. `allow read: if true` ise listelemeyi de açıyor
    // ve o anda anahtarın bir anlamı kalmıyor — kimliksiz bir istemci bütün
    // bilgi taleplerini tek istekte döküyordu. Aday tarafı zaten tekil
    // `getDoc` yapıyor (CandidateRespondPage); listeyi yalnızca giriş yapmış
    // iç sayfalar okuyor (MessagesPage, CandidateProcessPage).
    match /artifacts/talent-flow/public/data/infoRequests/{requestId} {
      allow get:   if true;
      allow list:  if isStrictAuthenticated();
      allow write: if isRecruiter();
    }

    // ── E-posta konuşmaları (Gmail thread takibi) ─────────────────────────────
    // Aday yazışmalarının gövdesini taşır — yalnızca recruiter.
    match /artifacts/talent-flow/public/data/emailThreads/{threadId} {
      allow read, write: if isRecruiter();
    }

    // ── Mesaj kuyruğu (planlı aday iletişimi) ─────────────────────────────────
    // MessageQueueProvider uygulama genelinde bağlanır; department_user'ın
    // dinleyicisi sessizce reddedilmesin diye okuma iç kullanıcıya açık,
    // yazma recruiter'a özel.
    match /artifacts/talent-flow/public/data/messageQueue/{messageId} {
      allow read:  if isStrictAuthenticated();
      allow write: if isRecruiter();
    }

    // ── Canlı mülakat katılımcı davetleri ─────────────────────────────────────
    // Bu koleksiyonun VARLIK NEDENİ department_user'ın kendi departmanı
    // dışındaki mülakatlarını görebilmesi (InterviewManagementPage
    // participantIds array-contains sorgusu) — okuma recruiter'a kısıtlanamaz.
    match /artifacts/talent-flow/public/data/participantInvites/{inviteId} {
      allow read:  if isStrictAuthenticated();
      allow write: if isRecruiter();
    }

    // ── Toplu içe aktarma işleri ──────────────────────────────────────────────
    // items alt koleksiyonu HAM CV METNİ taşır — okunması recruiter'a özel,
    // yazma yalnızca sunucuda (Admin SDK, bulk worker).
    match /artifacts/talent-flow/public/data/bulkImportJobs/{jobId} {
      allow read:  if isRecruiter();
      allow write: if false;

      match /items/{itemId} {
        allow read:  if isRecruiter();
        allow write: if false;
      }
    }

    // NOT: Önceden burada iki geniş catch-all kuralı vardı
    // ({collectionName}/{docId} ve {allPaths=**}). Firestore çakışan
    // kuralları OR'ladığı için bu kurallar yukarıdaki TÜM dar okuma
    // kısıtlarını (settings sırları, kullanıcı tokenları, departman
    // izolasyonu) etkisiz bırakıyordu. Kaldırıldılar; yeni koleksiyonlar
    // buraya AÇIK kural eklemek zorundadır (varsayılan: en alttaki deny).

    // ── Live Interview Sessions ───────────────────────────────────────────────
    // • get:    open — sessionId (128-bit UUID) acts as capability token
    // • list:   KAPALI (yalnızca giriş yapmış kullanıcı). Burada `read: if true`
    //           vardı ve `read` listelemeyi de kapsıyor: kimliksiz bir istemci
    //           BÜTÜN mülakat oturumlarını — transkriptler, AI analizi,
    //           skorlar, aday kimlikleri — tek istekte okuyabiliyordu. Yetki
    //           anahtarı fikri (linki olan tek kaydı görür) ancak liste
    //           kapalıyken anlamlı. Listeyi yalnızca iç ekranlar okuyor
    //           (Dashboard, InterviewManagementPage, PipelinePage); aday
    //           tarafı tekil okuma yapıyor.
    // • create: yalnızca strict-auth (recruiter akışı); aday tarafı doküman
    //           yoksa /api/init-interview-session fallback'ini kullanır
    //           (LiveInterviewPage permission-denied dallarında mevcut)
    // • update: recruiter serbest; anonim aday transkript/durum/WebRTC
    //           sinyalleşme alanlarını yazabilir ama DEĞERLENDİRME ÇIKTISINA
    //           ve soru akışı kontrolüne dokunamaz (aksi hâlde aday kendi
    //           mülakat skorunu tarayıcıdan yeniden yazabiliyordu).
    //           Aynı liste sunucuda da uygulanır — bkz.
    //           functions/routes/interview.js PROTECTED_SESSION_FIELDS;
    //           /api/init-interview-session kimlik istemediği için orada
    //           süzülmezse bu kural atlatılabilirdi.
    // • delete: denied
    match /interviews/{sessionId} {
      allow get:    if true;
      allow list:   if isStrictAuthenticated();
      allow create: if isStrictAuthenticated();
      allow update: if isRecruiter() ||
                       (isAuthenticatedIncAnon() &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                          'aiAnalysis', 'aggregateScore', 'recommendedOutcome',
                          'interviewScore', 'aiOverallScore', 'aiSummary',
                          'starScores', 'questions', 'currentQuestionIndex',
                          'candidateResponse', 'candidateId'
                        ]));
      allow delete: if false;
    }

    // ── Default deny ──────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
