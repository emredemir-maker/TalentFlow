rules_version = '2';
// ─────────────────────────────────────────────────────────────────────────────
// Clyro Talent — çok şirketli (multi-tenant) Firestore kuralları.
// Tasarım: docs/coklu-sirket-plani.md §2.2 ve §3.1. Testler: tests/rules/.
//
// MODEL
//   tenants/{tenantId}                  şirket: status, writeUntil, readUntil …
//   tenants/{tenantId}/members/{uid}    üyelik: role, departments[], status, expiresAt?
//   tenants/{tenantId}/<koleksiyon>/…   şirkete ait bütün veri
//
// TEMEL İLKELER
//   • Yetkinin TEK kaynağı üyelik belgesi. Firebase jetonundaki `role` talebine
//     hiçbir kuralda bakılmaz: Auth Hub ve CX ile ortak, global bir talep başka
//     uygulamada verilmiş bir yetkiyi buraya taşırdı.
//   • Şirket yolun parçası: bir eşleşmedeki `tenantId` ile üyelik belgesinin
//     yolu aynı değişkenden kuruluyor; başka şirketin verisine giden istek,
//     o şirkette üyelik bulamadığı için reddedilir. Liste sorgusu yapısal olarak
//     başka şirkete ulaşamaz.
//   • Üyeliği, şirket belgesini, şirket listesini yalnız sunucu (Admin SDK) yazar.
//   • Okuma `readUntil`'e, yazma `writeUntil`'e bağlı (K5: deneme bitince 14 gün
//     salt okunur, sonra kapalı). `support` rolü (K11) salt okunur ve
//     `expiresAt` dolunca kendiliğinden düşer.
//   • Eski ortak kök (`artifacts/talent-flow/**`) ve kök `interviews` KAPALI;
//     veri taşınmıyor (K10).
//   • En alttaki varsayılan red korunur: yeni bir koleksiyon AÇIK kural ve
//     tests/rules/matrix.js'te bir satır olmadan erişilemez.
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Kimlik ──────────────────────────────────────────────────────────────
    // Anonim oturum aday tarafındaki herkese açık sayfalar için; iç kullanıcı
    // değildir ve hiçbir şirkette üye sayılmaz.
    function signedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function anyAuth() {
      return request.auth != null;
    }

    // ── Üyelik ──────────────────────────────────────────────────────────────
    // get()/exists() aynı belge için istek içinde önbelleklenir; tipik kural
    // üyelik (1) + şirket belgesi (1) = 2 belge okur (sınır: 10 / sorguda 20).
    function memberPath(t) {
      return /databases/$(database)/documents/tenants/$(t)/members/$(request.auth.uid);
    }

    function member(t) {
      return get(memberPath(t)).data;
    }

    // Etkin üye: belge var, durum 'active', süreli üyelikse (destek) süresi dolmamış.
    function isMember(t) {
      return signedIn() &&
        exists(memberPath(t)) &&
        member(t).get('status', '') == 'active' &&
        (member(t).get('expiresAt', null) == null || request.time < member(t).expiresAt);
    }

    function hasRole(t, roles) {
      return isMember(t) && member(t).get('role', '') in roles;
    }

    // Rol kümeleri. `support` yalnız okur.
    function allRoles()        { return ['admin', 'recruiter', 'department_user', 'support']; }
    function readAllRoles()    { return ['admin', 'recruiter', 'support']; }
    function writerRoles()     { return ['admin', 'recruiter']; }
    function selfWriterRoles() { return ['admin', 'recruiter', 'department_user']; }

    // ── Şirket durumu (K5) ──────────────────────────────────────────────────
    // Şirket belgesi yoksa get() hata verir → kural reddeder (güvenli hata).
    function tenantDoc(t) {
      return get(/databases/$(database)/documents/tenants/$(t)).data;
    }

    function tenantReadable(t) {
      return tenantDoc(t).get('status', '') in ['trial', 'active', 'readonly'] &&
        request.time < tenantDoc(t).readUntil;
    }

    // Rol gerektirmeyen yazma penceresi (anonim adayın mülakat yazımı için).
    function tenantOpenForWrites(t) {
      return tenantDoc(t).get('status', '') in ['trial', 'active'] &&
        request.time < tenantDoc(t).writeUntil &&
        request.time < tenantDoc(t).readUntil;
    }

    function canRead(t, roles) {
      return tenantReadable(t) && hasRole(t, roles);
    }

    function canWrite(t, roles) {
      return tenantOpenForWrites(t) && hasRole(t, roles);
    }

    // ── Departman görünürlüğü ───────────────────────────────────────────────
    // department_user yalnız kendi departmanındaki ya da kendi departmanına
    // açılmış (visibleToDepartments) adayı görür; departmansız üye hiçbir aday
    // görmez (K2). Liste kuralı her belgeye karşı kanıtlanmak zorunda olduğu
    // için süzgeçsiz sorgu reddedilir.
    //
    // `visibleToDepartments.hasAny(departments)` sırası bilerek böyle: ters
    // sıra (`departments.hasAny(visibleToDepartments)`) eski kurallardaydı ve
    // Firestore `array-contains-any` sorgusunu ondan kanıtlayamıyordu — sorgu
    // reddediliyor, paylaşılan aday görünmüyordu.
    function deptCanSee(t, data) {
      return data.get('department', '') in member(t).get('departments', []) ||
        data.get('visibleToDepartments', []).hasAny(member(t).get('departments', []));
    }

    function canReadCandidate(t, data) {
      return canRead(t, readAllRoles()) ||
        (canRead(t, ['department_user']) && deptCanSee(t, data));
    }

    // Mülakat değerlendirme çıktısı ve soru akışı — aday tarafı dokunamaz
    // (aynı liste sunucuda: functions/routes/interview.js PROTECTED_SESSION_FIELDS).
    function interviewProtectedTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'aiAnalysis', 'aggregateScore', 'recommendedOutcome',
        'interviewScore', 'aiOverallScore', 'aiSummary',
        'starScores', 'questions', 'currentQuestionIndex',
        'candidateResponse', 'candidateId'
      ]);
    }

    // Sır taşıyan ayar belgeleri şirket altında da açılmaz (platform sırları
    // platform/*'ta; şirket anahtarı gelirse sunucuya özel olur).
    function isSecretSetting(settingId) {
      return settingId in ['api_keys', 'integrations', 'secrets'];
    }

    // Üyenin kendi belgesinde değiştirebileceği alanlar — İZİN LİSTESİ.
    // Rol, departman, durum, e-posta, Hub rolü, süre: yalnız sunucu.
    function memberSelfFields() {
      return ['displayName', 'photoURL', 'lastSeenAt'];
    }

    // ── Şirket ağacı ────────────────────────────────────────────────────────
    match /tenants/{tenantId} {
      // Ad, durum, plan — sır burada tutulmaz. Kapanmış şirkette de üye kendi
      // şirketinin durumunu görebilsin diye tenantReadable aranmaz.
      allow get: if isMember(tenantId);
      allow list, write: if false;

      // ── TENANT KOLEKSİYONLARI BAŞI (tests/rules/matrix.js ile eşleşmeli) ──

      match /members/{uid} {
        allow get: if isMember(tenantId) &&
          (request.auth.uid == uid || canRead(tenantId, readAllRoles()));
        allow list: if canRead(tenantId, readAllRoles());
        allow update: if request.auth.uid == uid &&
          canWrite(tenantId, selfWriterRoles()) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(memberSelfFields());
        allow create, delete: if false;

        // Kişinin kendi alt koleksiyonları (preferences, assistantChats …).
        // `/{collection}/` parçası ZORUNLU: `/{x=**}` sıfır parçayla da eşleşir
        // ve üyelik belgesinin kendisini kapsayıp yukarıdaki rol korumasını
        // OR'la geçersiz kılardı (eski users kuralındaki açık buydu).
        match /{collection}/{rest=**} {
          allow read: if request.auth.uid == uid && canRead(tenantId, allRoles());
          allow write: if request.auth.uid == uid && canWrite(tenantId, selfWriterRoles());
        }
      }

      match /candidates/{candidateId} {
        allow get, list: if canReadCandidate(tenantId, resource.data);
        // Anonim aday doğrudan aday açamaz; başvuru yalnız sunucu üzerinden (§2.5).
        allow create, update, delete: if canWrite(tenantId, writerRoles());
      }

      match /positions/{positionId} {
        // Açık ilan: başvuru sayfası (anonim dahil) tekil okur. Kapalı ilan ve
        // liste yalnız üyeye.
        allow get: if tenantReadable(tenantId) &&
          (resource.data.get('status', '') == 'open' || isMember(tenantId));
        allow list: if canRead(tenantId, allRoles());
        allow create, update, delete: if canWrite(tenantId, writerRoles());
      }

      match /applications/{applicationId} {
        // Başvuru oluşturma yalnız sunucu (/api/applications) — hedef şirketi
        // istemci değil sunucu belirler.
        allow read: if canRead(tenantId, readAllRoles());
        allow update, delete: if canWrite(tenantId, writerRoles());
        allow create: if false;
      }

      match /departments/{deptId} {
        allow read: if canRead(tenantId, allRoles());
        allow write: if canWrite(tenantId, ['admin']);
      }

      match /sources/{sourceId} {
        // Başvuru formundaki "bizi nereden duydunuz" listesi: anonim aday da
        // okur. Şirket bilgisi değil, kaynak adları.
        allow read: if anyAuth() && tenantReadable(tenantId);
        allow write: if canWrite(tenantId, writerRoles());
      }

      match /settings/{settingId} {
        allow get: if !isSecretSetting(settingId) &&
          (settingId in ['system', 'branding']
            ? canRead(tenantId, allRoles())
            : canRead(tenantId, readAllRoles()));
        allow list: if false;
        allow write: if !isSecretSetting(settingId) && canWrite(tenantId, ['admin']);
      }

      match /infoRequests/{requestId} {
        // Kimlik = yetki anahtarı (aday yanıt bağlantısı): tekil okuma açık,
        // liste yalnız üyeye.
        allow get: if tenantReadable(tenantId);
        allow list: if canRead(tenantId, allRoles());
        allow write: if canWrite(tenantId, writerRoles());
      }

      match /emailThreads/{threadId} {
        allow read: if canRead(tenantId, readAllRoles());
        allow write: if canWrite(tenantId, writerRoles());
      }

      match /messageQueue/{messageId} {
        allow read: if canRead(tenantId, allRoles());
        allow write: if canWrite(tenantId, writerRoles());
      }

      match /participantInvites/{inviteId} {
        // department_user kendi departmanı dışındaki mülakat davetini görür.
        allow read: if canRead(tenantId, allRoles());
        allow write: if canWrite(tenantId, writerRoles());
      }

      match /bulkImportJobs/{jobId} {
        // items ham CV metni taşır; yazma yalnız sunucu işçisi.
        allow read: if canRead(tenantId, readAllRoles());
        allow write: if false;

        match /items/{itemId} {
          allow read: if canRead(tenantId, readAllRoles());
          allow write: if false;
        }
      }

      match /accessLogs/{logId} {
        // Denetim defteri: yalnız ekleme; okuma şirket yöneticisi. Salt okunur
        // şirkette ve destek üyesinde de kayıt düşer (okumalar kaydedilir).
        allow read: if canRead(tenantId, ['admin']);
        allow create: if isMember(tenantId) && tenantReadable(tenantId) &&
          request.resource.data.get('uid', '') == request.auth.uid;
        allow update, delete: if false;
      }

      match /usage/{day} {
        allow read: if canRead(tenantId, ['admin']);
        allow write: if false;
      }

      match /interviews/{sessionId} {
        // Oturum kimliği (128 bit) = yetki anahtarı: tekil okuma açık, liste üyeye.
        allow get: if tenantReadable(tenantId);
        allow list: if canRead(tenantId, allRoles());
        allow create: if canWrite(tenantId, writerRoles());
        // Aday (anonim) ve katılımcılar transkript/durum/sinyalleşme yazar;
        // değerlendirme alanlarına yalnız recruiter.
        // Destek üyesi (K11) salt okunur: listeden öğrendiği oturumlara bu
        // daldan da yazamasın diye açıkça dışarıda.
        allow update: if canWrite(tenantId, writerRoles()) ||
          (anyAuth() && tenantOpenForWrites(tenantId) && !interviewProtectedTouched() &&
            !hasRole(tenantId, ['support']));
        allow delete: if false;
      }

      match /integrationSecrets/{uid} {
        // Şifreli OAuth jetonları — yalnız sunucu.
        allow read, write: if false;
      }

      // ── TENANT KOLEKSİYONLARI SONU ──
    }

    // ── Platform ve köprü belgeleri — yalnız sunucu ─────────────────────────
    match /userTenants/{uid} {
      // Şirket seçici için kişinin şirket listesi.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    match /publicLinks/{linkId} {
      // Yalnız /api/public/resolve (sunucu) okur.
      allow read, write: if false;
    }

    match /platform/{document=**} {
      allow read, write: if false;
    }

    match /platformUsage/{day} {
      allow read, write: if false;
    }

    // ── Eski ortak kök — KAPALI (K10, veri taşınmıyor) ─────────────────────
    // Varsayılan red zaten kapsıyor; açık kural niyeti belgeliyor ve testte
    // sabitleniyor. Temizlik PR 8'de.
    match /artifacts/{document=**} {
      allow read, write: if false;
    }

    match /interviews/{document=**} {
      allow read, write: if false;
    }

    // ── Varsayılan red ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
